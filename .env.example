RSS_PUBLIC_BASE_URL=https://rss.lab.amvc.me
RSS_DATA_DIR=./data
RSS_PUBLIC_DIR=./public
RSS_FEED_PATH=/feed.xml
RSS_ENTRY_PATH=/entries
RSS_MEDIA_PATH=/media
RSS_FILES_PATH=/files

# Optional auth for the HTTP asset API. The internal MCP is normally loopback-only.
RSS_AUTH_MODE=none
# RSS_API_TOKEN=change-me

RSS_MAX_UPLOAD_BYTES=104857600
RSS_ORPHAN_ASSET_TTL_SECONDS=604800

# Optional OpenAI-compatible embeddings. Publishing works without these.
RSS_EMBEDDINGS_ENABLED=false
# RSS_EMBEDDINGS_BASE_URL=http://embedding-host:4000/v1
# RSS_EMBEDDINGS_API_KEY=sk-local
# RSS_EMBEDDINGS_MODEL=text-embedding-3-small
# RSS_EMBEDDINGS_DIMENSIONS=384

# MCP server: stdio by default. Appliance uses streamable-http on loopback.
RSS_MCP_TRANSPORT=stdio
RSS_MCP_LISTEN_HOST=127.0.0.1
RSS_MCP_LISTEN_PORT=8766
RSS_API_LISTEN_HOST=127.0.0.1
RSS_API_LISTEN_PORT=8765
